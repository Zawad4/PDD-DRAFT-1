# ==============================================================================
# Turfington Environment Configuration Template
# COPY this file to .env and configure your local or production secrets.
# NEVER commit the real .env file with secrets to Git or GitHub!
# ==============================================================================

# Application Environment (development | production)
NODE_ENV="production"
PORT=5000

# Firebase Client Configuration (Safe for frontend injection)
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# Payment Gateway (Razorpay)
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder"
# NEVER prefix secret keys with VITE_ (server-side only)
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=""

# SMS Gateway (Fast2SMS) - Server side only
FAST2SMS_API_KEY=""

