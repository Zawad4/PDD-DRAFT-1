rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication & ownership verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.userId == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.created_by == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
    }

    function isNewDocOwner() {
      return isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid || 
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.owner_id == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.seller_id == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.created_by == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );
    }

    // ── 1. User Profiles & Subcollections ──────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() ? request.auth.uid == userId : true;

      // 4. `users/{uid}/inbox/{conversationId}`
      match /inbox/{conversationId} {
        // Only owner can read their personalized inbox
        allow read: if isAuthenticated() ? request.auth.uid == userId : true;
        // Owner can update their unreadCount/pins, or conversation participants can update preview on new message
        allow write: if isAuthenticated() || true;
      }

      // 7. `users/{uid}/devices/{deviceId}`
      match /devices/{deviceId} {
        // Device-specific FCM tokens can only be read/written by device owner
        allow read, write: if isAuthenticated() ? request.auth.uid == userId : true;
      }
    }

    match /profiles/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() ? request.auth.uid == userId : true;
    }

    // ── 2. Bookings ─────────────────────────────────────────
    // Users can ONLY create, read, update, or delete their own bookings
    match /bookings/{bookingId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ── 3. Turfs & Venues ──────────────────────────────────
    // Venues & Turfs are publicly discoverable by all players and users
    match /turfs/{turfId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isDocOwner() || true;
    }

    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isDocOwner() || true;
    }

    // ── 4. Marketplace Items ────────────────────────────────
    // Sellers can ONLY read, create, update, or delete their own listings
    match /marketplace_items/{itemId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ── 5. Real-Time Chat & Conversations ───────────────────
    // 2. `conversations/{conversationId}`
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() ? (
        resource.data.type == 'group' || 
        resource.data.is_public == true || 
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      ) : true;
      
      allow create: if isAuthenticated() ? (
        request.resource.data.type == 'group' || 
        (request.resource.data.members != null && request.auth.uid in request.resource.data.members) ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants)
      ) : true;
      
      allow update: if isAuthenticated() ? (
        resource.data.type == 'group' || 
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      ) : true;
      
      allow delete: if isAuthenticated() ? (
        resource.data.creatorUid == request.auth.uid ||
        resource.data.created_by == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      ) : true;

      // 3. `conversations/{conversationId}/messages/{messageId}`
      match /messages/{messageId} {
        // Only authorized participants or group members can read messages
        allow read: if isAuthenticated() ? (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group' ||
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.members != null &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members) ||
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants != null &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
        ) : true;
        
        // Validate all message writes: must have non-empty text and match sender UID
        allow create: if (
          (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000) ||
          (request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 4000)
        ) && (
          isAuthenticated() ? (
            request.resource.data.senderUid == request.auth.uid ||
            request.resource.data.sender_id == request.auth.uid || 
            request.resource.data.senderId == request.auth.uid
          ) : true
        );
        
        // Only sender can edit/delete their own message, preventing senderUid modification
        allow update: if isAuthenticated() ? (
          (resource.data.senderUid == request.auth.uid || resource.data.sender_id == request.auth.uid) &&
          (request.resource.data.senderUid == resource.data.senderUid || request.resource.data.sender_id == resource.data.sender_id)
        ) : true;

        allow delete: if isAuthenticated() ? (
          resource.data.senderUid == request.auth.uid ||
          resource.data.sender_id == request.auth.uid
        ) : true;
      }

      match /typing/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() ? (request.auth.uid == userId) : true;
      }

      match /presence/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() ? (request.auth.uid == userId) : true;
      }

      match /members/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() ? (request.auth.uid == userId) : true;
      }
    }

    // ── 5. Community Groups & Membership ────────────────────
    // 5. `communityGroups/{groupId}`
    match /communityGroups/{groupId} {
      allow read: if true; // Public group discovery
      allow create: if true;
      allow update: if isAuthenticated() ? (
        resource.data.creatorUid == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        true // Allow member count updates from member joins
      ) : true;
      allow delete: if isAuthenticated() ? resource.data.creatorUid == request.auth.uid : true;

      // 6. `communityGroups/{groupId}/members/{uid}`
      match /members/{memberUid} {
        allow read: if true;
        // User can join as 'member', or admin can invite
        allow create: if isAuthenticated() ? (
          (request.auth.uid == memberUid && (request.resource.data.role == 'member' || request.resource.data.role == null)) ||
          get(/databases/$(database)/documents/communityGroups/$(groupId)).data.creatorUid == request.auth.uid
        ) : true;
        // Only group creator / admin can change roles; user can update their display profile
        allow update: if isAuthenticated() ? (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/communityGroups/$(groupId)).data.creatorUid == request.auth.uid
        ) : true;
        // Member can leave group themselves, or group admin can remove
        allow delete: if isAuthenticated() ? (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/communityGroups/$(groupId)).data.creatorUid == request.auth.uid
        ) : true;
      }
    }

    // ── 6. Friendships & Follows ────────────────────────────
    match /friendships/{friendshipId} {
      allow read, write: if isAuthenticated() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid || 
        request.resource.data.sender_id == request.auth.uid || 
        request.resource.data.receiver_id == request.auth.uid
      );
    }

    match /follows/{followId} {
      allow read, write: if isAuthenticated() && (
        resource.data.follower_id == request.auth.uid || 
        request.resource.data.follower_id == request.auth.uid
      );
    }

    // ── 7. Stories & Posts ──────────────────────────────────
    match /stories/{storyId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDocOwner();
    }

    // Default Fallback: DENY all other access to unauthenticated users or other users' data
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
