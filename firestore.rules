rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication & ownership verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.userId == request.auth.uid ||
        resource.data.owner_id == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.created_by == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid
      );
    }

    function isNewDocOwner() {
      return isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid || 
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.owner_id == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.seller_id == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.created_by == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid
      );
    }

    // ── 1. User Profiles & Subcollections ──────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Inbox subcollection: personal to user
      match /inbox/{conversationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isAuthenticated();
      }

      // FCM device tokens: strictly private to user
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // ── 2. Bookings ─────────────────────────────────────────
    // Users can ONLY create, read, update, or delete their own bookings
    match /bookings/{bookingId} {
      allow create: if isNewDocOwner();
      allow read, update, delete: if isDocOwner();
    }

    // ── 3. Turfs & Venues ──────────────────────────────────
    // Discoverable publicly; only verified owners can modify/delete
    match /turfs/{turfId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isDocOwner();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isDocOwner();
    }

    // ── 4. Marketplace Items ────────────────────────────────
    // Public listings; only item seller can edit or delete
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create: if isNewDocOwner();
      allow update, delete: if isDocOwner();
    }

    // ── 5. Real-Time Chat & Conversations ───────────────────
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        resource.data.type == 'group' || 
        resource.data.is_public == true || 
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.type == 'group' || 
        (request.resource.data.members != null && request.auth.uid in request.resource.data.members) ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants)
      );
      
      allow update: if isAuthenticated() && (
        resource.data.type == 'group' || 
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.creatorUid == request.auth.uid ||
        resource.data.created_by == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        
        allow create: if isAuthenticated() && (
          (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000) ||
          (request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 4000)
        ) && (
          request.resource.data.senderUid == request.auth.uid ||
          request.resource.data.sender_id == request.auth.uid || 
          request.resource.data.senderId == request.auth.uid
        );
        
        allow update, delete: if isAuthenticated() && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.sender_id == request.auth.uid ||
          resource.data.senderId == request.auth.uid
        );
      }

      match /typing/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /presence/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /members/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // ── 6. Community Groups & Membership ────────────────────
    match /communityGroups/{groupId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.creatorUid == request.auth.uid ||
        (resource.data.members != null && request.auth.uid in resource.data.members)
      );
      allow delete: if isAuthenticated() && resource.data.creatorUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/communityGroups/$(groupId)).data.creatorUid == request.auth.uid
        );
        allow update: if isAuthenticated() && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/communityGroups/$(groupId)).data.creatorUid == request.auth.uid
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/communityGroups/$(groupId)).data.creatorUid == request.auth.uid
        );
      }
    }

    // ── 7. Friendships & Follows ────────────────────────────
    match /friendships/{friendshipId} {
      allow read, write: if isAuthenticated() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid || 
        request.resource.data.sender_id == request.auth.uid || 
        request.resource.data.receiver_id == request.auth.uid
      );
    }

    match /follows/{followId} {
      allow read, write: if isAuthenticated() && (
        resource.data.follower_id == request.auth.uid || 
        request.resource.data.follower_id == request.auth.uid
      );
    }

    // ── 8. Stories & Posts ──────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isNewDocOwner();
      allow update, delete: if isDocOwner();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNewDocOwner();
      allow update: if isAuthenticated();
      allow delete: if isDocOwner();
    }

    // Default Fallback: DENY all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
